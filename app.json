{
  "expo": {
    "name": "moneylynx",
    "slug": "moneylynx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moneylynx",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "icon": "./assets/playstore.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sharyar_naveed.MoneyLynx",
      "adaptiveIcon": {
        "foregroundImage": "./assets/playstore.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "eas": {
        "projectId": "02c50cb8-a015-46c4-a852-3f85997d888a"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/playstore.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "owner": "sharyar_naveed"
  }
}
